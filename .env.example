# Base da API do Quero. Vazia (ou ausente), a SPA roda com os dados de
# demonstração: as telas exercitam carregamento, erro e estado vazio sem
# fingir que há persistência.
# Com o backend local: VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=

# Tempo limite de cada requisição HTTP, em milissegundos.
VITE_API_TIMEOUT=15000
