# Base da API do Quero, com o prefixo de versão. Obrigatória: todas as telas
# leem do backend e não há dados de demonstração. Sem ela, as chamadas falham
# e as telas mostram o estado de erro.
# Backend local (docker compose no repositório do backend):
VITE_API_URL=http://localhost:8000/api/v1

# Tempo limite de cada requisição HTTP, em milissegundos.
VITE_API_TIMEOUT=15000
